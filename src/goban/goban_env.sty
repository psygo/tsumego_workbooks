\newcommand\partialBoardClipping{
  \ifthenelse{
    \equal{\horClipStart}{-1} \AND
    \equal{\horClipEnd}{-1} \AND
    \equal{\verClipStart}{-1} \AND
    \equal{\verClipEnd}{-1}
  }{}{
    \tikzmath{
      \horStart = (-1.5 + \horClipStart) * \step;
      \horEnd   = (\horClipEnd) * \step;
      \verStart = (-1.5 + \verClipStart) * \step;
      \verEnd   = (\verClipEnd) * \step;
    }

    \clip (\horStart, \verStart) rectangle 
          (\horEnd, \verEnd);
  }
}

% The clip only wraps the grid/split-line/stones (opened here, closed in the
% environment's "after" code below) --- coordinate labels are drawn once it's
% closed, so they're never at risk of being cropped by a partial-board clip
% rectangle sized for the board itself, regardless of their font size.
\newenvironment{goban}[1][]{
  \pgfkeys{/phili/goban/.cd, #1}

  \begin{tikzpicture}[scale = \scale,
                      transform shape]
    \calculateStep

    \begin{scope}
    \partialBoardClipping

    \draw[\splitLineStyle,
          line width = \splitLineWidth]
      (0, 0) -- (\boardDimension, \boardDimension);

    \goGrid
}{
    \end{scope}

    \ifthenelse{\equal{\showCoordinates}{true}}{\drawCoordinates}{}

    \setcounter{moveCounter}{1}
  \end{tikzpicture}
}

